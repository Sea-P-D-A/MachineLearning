# ====================
# ОСТАЛЬНОЙ КОД БЕЗ ИЗМЕНЕНИЙ
# ====================
from tensorflow import keras
from keras import layers


def build_model_simple(input_shape=(128, 128, 3)):
    model = keras.Sequential([
        layers.Rescaling(1. / 255),                 # Нормализация: преобразование пикселей [0-255] → [0-1]
        layers.Conv2D(16, 3, activation="relu"),  # 1-я свертка: 16 фильтров 3x3
        layers.MaxPool2D(),                                        # 1-й пуллинг: уменьшение в 2 раза
        layers.Conv2D(32, 3, activation="relu"),  # 2-я свертка: 32 фильтра 3x3
        layers.MaxPool2D(),                                 # 2-й пуллинг: уменьшение в 2 раза
        layers.Flatten(),                                   # "Распрямление" 2D-тензора в вектор
        layers.Dense(32, activation="relu"),          # Полносвязный слой: 32 нейрона
        layers.Dense(1, activation="sigmoid")         # Выходной слой: 1 нейрон (кошка/собака)
    ])
    model.compile(optimizer="adam", loss="binary_crossentropy", metrics=["accuracy"])
    return model


def build_model_medium(input_shape=(128, 128, 3)):
    model = keras.Sequential([
        layers.Rescaling(1. / 255),
        layers.Conv2D(32, 3, padding="same", activation="relu"),  # padding="same" сохраняет размер
        layers.BatchNormalization(),                              # Нормализация батча - ускоряет обучение
        layers.MaxPool2D(),
        layers.Conv2D(64, 3, padding="same", activation="relu"),  # Больше фильтров
        layers.BatchNormalization(),
        layers.MaxPool2D(),
        layers.Conv2D(128, 3, padding="same", activation="relu"),  # Еще больше фильтров
        layers.BatchNormalization(),
        layers.MaxPool2D(),
        layers.Flatten(),
        layers.Dense(128, activation="relu"),
        layers.Dropout(0.3),  # Регуляризация Dropout - предотвращает переобучение
        layers.Dense(1, activation="sigmoid")
    ])
    model.compile(optimizer=keras.optimizers.Adam(1e-3), loss="binary_crossentropy", metrics=["accuracy"])
    return model


def conv_block(filters):
    return keras.Sequential([
        layers.Conv2D(filters, 3, padding="same", activation="relu"),
        layers.BatchNormalization(),
        layers.Conv2D(filters, 3, padding="same", activation="relu"),
        layers.BatchNormalization(),
    ])


def build_model_deep(input_shape=(128, 128, 3)):
    inputs = keras.Input(shape=input_shape)
    x = layers.Rescaling(1. / 255)(inputs)

    # Block 1
    x = layers.Conv2D(32, 3, padding="same", activation="relu")(x)
    x = layers.MaxPool2D()(x)

    # Block 2 (residual-like)
    x_res = conv_block(32)(x)
    x = layers.Add()([x, x_res])
    x = layers.MaxPool2D()(x)

    # Block 3 (residual-like)
    x_res = conv_block(32)(x)
    x = layers.Add()([x, x_res])
    x = layers.MaxPool2D()(x)

    x = layers.Flatten()(x)
    x = layers.Dense(256, activation="relu")(x)
    x = layers.Dropout(0.4)(x)
    outputs = layers.Dense(1, activation="sigmoid")(x)

    model = keras.Model(inputs, outputs)
    model.compile(optimizer=keras.optimizers.Adam(1e-4), loss="binary_crossentropy", metrics=["accuracy"])
    return model


# ====================
# СОЗДАНИЕ И ОБУЧЕНИЕ МОДЕЛЕЙ
# ====================
models = {
    "simple": build_model_simple(),
    "medium": build_model_medium(),
    "deep": build_model_deep(),
}
histories = {}

print("\n" + "=" * 60)
print("НАЧАЛО ОБУЧЕНИЯ МОДЕЛЕЙ")
print("=" * 60)

for name, model in models.items():
    print(f"\n===== Обучаю модель: {name} =====")
    history = model.fit(
        ds_train,
        validation_data=ds_valid,
        epochs=10,
        verbose=1
    )
    histories[name] = history
    print(f"Модель '{name}' обучена!")

# ====================
# ВИЗУАЛИЗАЦИЯ РЕЗУЛЬТАТОВ
# ====================
import pandas as pd


def plot_all_histories(histories):
    num_models = len(histories)
    fig, axes = plt.subplots(2, num_models, figsize=(6 * num_models, 10))

    if num_models == 1:
        axes = np.array([[axes[0]], [axes[1]]])

    for idx, (name, history) in enumerate(histories.items()):
        df = pd.DataFrame(history.history)

        # LOSS
        ax = axes[0, idx]
        ax.plot(df["loss"], label="train_loss")
        ax.plot(df["val_loss"], label="val_loss")
        ax.set_title(f"{name} — Потери")
        ax.set_xlabel("Эпохи")
        ax.set_ylabel("Потери")
        ax.legend()
        ax.grid(True, alpha=0.3)

        # ACCURACY
        ax = axes[1, idx]
        if "accuracy" in df.columns:
            acc, val_acc = "accuracy", "val_accuracy"
        else:
            acc, val_acc = "binary_accuracy", "val_binary_accuracy"

        ax.plot(df[acc], label=f"train_{acc}")
        ax.plot(df[val_acc], label=f"val_{acc}")
        ax.set_title(f"{name} — Точность")
        ax.set_xlabel("Эпохи")
        ax.set_ylabel("Точность")
        ax.legend()
        ax.grid(True, alpha=0.3)

    plt.tight_layout()
    plt.show()


print("\n" + "=" * 60)
print("ВИЗУАЛИЗАЦИЯ РЕЗУЛЬТАТОВ")
print("=" * 60)
plot_all_histories(histories)

