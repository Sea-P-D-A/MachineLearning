import matplotlib.pyplot as plt
import numpy as np
from sklearn.model_selection import learning_curve

print("\n\n----ДОПОЛНЕНИЕ----\n\n")

# Random Forest:
# 1.Строит независимые деревья
# 2.Использует бэггинг (усреднение предсказаний)
# 3.Хорошо борется с переобучением, но может "недотягивать" в точности

# XGBoost (Gradient Boosting):
# 1.Строит деревья последовательно
# 2.Каждое новое дерево исправляет ошибки предыдущего
# 3.Использует градиентный спуск для минимизации ошибки
# 4.очень быстро может переобучится

# ======== ГРАФИКИ ========

print("\n" + "=" * 70)
print("ПОСТРОЕНИЕ ГРАФИКОВ ДЛЯ ВСЕХ МОДЕЛЕЙ")
print("=" * 70)

# Создаем списки для хранения данных
rf_models = []
rf_model_names = []
rf_val_errors = []  # Ошибки валидации
rf_train_errors = []  # Ошибки обучения

xgb_models = []
xgb_model_names = []
xgb_val_errors = []  # Ошибки валидации
xgb_train_errors = []  # Ошибки обучения

print("\nПодготовка данных для Random Forest моделей...")

# Создаем Random Forest модели с разными препроцессорами
for i, preproc in enumerate(preprocessor_mas):
    rf_model = Pipeline([
        ('preprocessor', preproc),
        ('model', RandomForestRegressor(n_estimators=100, random_state=42))
    ])

    # Получаем кривые обучения
    train_sizes, train_scores, val_scores = learning_curve(
        rf_model, X_train, y_train, cv=3,
        scoring='neg_mean_absolute_error',
        train_sizes=np.linspace(0.2, 1.0, 5),
        random_state=42,
        n_jobs=-1
    )

    train_mae = -train_scores.mean(axis=1)
    val_mae = -val_scores.mean(axis=1)

    rf_models.append((train_sizes, train_mae, val_mae))
    rf_model_names.append(f'RF Model {i + 1}')
    rf_val_errors.append(val_mae[-1])  # Последнее значение ошибки валидации
    rf_train_errors.append(train_mae[-1])  # Последнее значение ошибки обучения

    print(f"  RF Model {i + 1}: обучение = {train_mae[-1]:.4f}, валидация = {val_mae[-1]:.4f}")

print(f"\nПодготовлено {len(rf_models)} Random Forest моделей")

print("\nПодготовка данных для XGBoost моделей...")

# Создаем XGBoost модели с разными препроцессорами
for i, preproc in enumerate(preprocessor_mas):
    xgb_model = Pipeline([
        ('preprocessor', preproc),
        ('model', XGBRegressor(n_estimators=100, random_state=42))
    ])

    # Получаем кривые обучения
    train_sizes, train_scores, val_scores = learning_curve(
        xgb_model, X_train, y_train, cv=3,
        scoring='neg_mean_absolute_error',
        train_sizes=np.linspace(0.2, 1.0, 5),
        random_state=42,
        n_jobs=-1
    )

    train_mae = -train_scores.mean(axis=1)
    val_mae = -val_scores.mean(axis=1)

    xgb_models.append((train_sizes, train_mae, val_mae))
    xgb_model_names.append(f'XGB Model {i + 1}')
    xgb_val_errors.append(val_mae[-1])  # Последнее значение ошибки валидации
    xgb_train_errors.append(train_mae[-1])  # Последнее значение ошибки обучения

    print(f"  XGB Model {i + 1}: обучение = {train_mae[-1]:.4f}, валидация = {val_mae[-1]:.4f}")

print(f"\nПодготовлено {len(xgb_models)} XGBoost моделей")

# ======== ГРАФИК 1: ОШИБКА ВАЛИДАЦИИ RANDOM FOREST ========
print("\n1. Строим график ошибки валидации для Random Forest...")

fig1, ax1 = plt.subplots(figsize=(14, 6))

# Цвета для разных моделей
colors = plt.cm.Set3(np.linspace(0, 1, len(rf_models)))

for i, (train_sizes, train_mae, val_mae) in enumerate(rf_models):
    ax1.plot(train_sizes, val_mae, 'o-', color=colors[i],
             linewidth=2, markersize=6, label=rf_model_names[i])

ax1.set_title('Ошибка валидации (Validation Error) - Random Forest', fontsize=16, fontweight='bold')
ax1.set_xlabel('Размер обучающей выборки', fontsize=12)
ax1.set_ylabel('MAE (ошибка валидации)', fontsize=12)
ax1.legend(title='Модели RF', fontsize=10, title_fontsize=11)
ax1.grid(True, alpha=0.3)
ax1.set_ylim(bottom=0)  # Начинаем с 0 для лучшей наглядности

# Добавляем аннотации для последних значений
for i, val_error in enumerate(rf_val_errors):
    ax1.text(train_sizes[-1], val_error, f'  {val_error:.3f}',
             fontsize=9, verticalalignment='center')

plt.tight_layout()
plt.savefig('rf_validation_error.png', dpi=150, bbox_inches='tight')
print("✓ График сохранен: 'rf_validation_error.png'")
plt.show()

